{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "attribution": {
    "commit": "🤖 Generated with Claude Code",
    "pr": "🤖 Generated with Claude Code"
  },
  "permissions": {
    "allow": ["mcp__context7__*"],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Read(*.env)",
      "Edit(*.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Bash(cat *.env*)",
      "Bash(grep *.env*)",
      "Read(~/.ssh)",
      "Edit(~/.ssh)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.pub)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.pub)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/service-account.json)",
      "Read(**/service_account.json)",
      "Read(~/.config)",
      "Edit(~/.config)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf *)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post_write_lint.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh"
  },
  "enabledPlugins": {
    "reviewing-skill@kogatakanori-skills": true,
    "pattern-detector@kogatakanori-skills": true,
    "verifying-consistency@kogatakanori-skills": true,
    "arc@kogatakanori-skills": true
  },
  "extraKnownMarketplaces": {
    "kogatakanori-skills": {
      "source": {
        "source": "github",
        "repo": "kogatakanori/skills"
      }
    }
  },
  "language": "japanese"
}
