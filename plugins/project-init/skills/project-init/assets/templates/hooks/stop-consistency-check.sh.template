#!/usr/bin/env bash
# Stop hook - 作業完了時に実装とドキュメントの整合性を確認する
# 変更パターンに応じてClaudeに軽量チェックを促す（問題なければ1行で完結）

set -euo pipefail

# 変更ファイルをドキュメント／コードに分類
CHANGED_DOCS=$(git status --porcelain 2>/dev/null | awk '{print $2}' | grep -E '\.(md|txt|rst|adoc)$' || true)
CHANGED_CODE=$(git status --porcelain 2>/dev/null | awk '{print $2}' | grep -E '\.(py|js|ts|tsx|jsx|go|rs|java|sh|rb)$' || true)

# 変更なければスキップ
if [ -z "$CHANGED_DOCS" ] && [ -z "$CHANGED_CODE" ]; then
    exit 0
fi

# 同じ変更セットを前回もチェックしていればスキップ（ループ防止）
CACHE_KEY="${CHANGED_DOCS}|${CHANGED_CODE}"
CACHE=".claude/.consistency_hash"
if [ -f "$CACHE" ] && [ "$(cat "$CACHE")" = "$CACHE_KEY" ]; then
    exit 0
fi
printf '%s' "$CACHE_KEY" > "$CACHE"

# 変更パターンに応じてチェック依頼を出力
if [ -n "$CHANGED_DOCS" ] && [ -n "$CHANGED_CODE" ]; then
    echo "【整合性確認】ドキュメントとコードが同時に変更されています。変更されたファイル間で矛盾がないか簡潔に確認してください（問題なければ1行で報告）。"
elif [ -n "$CHANGED_CODE" ]; then
    echo "【整合性確認】コードが変更されました。プロジェクトの仕様ドキュメント（AGENT.md, docs/）と整合しているか簡潔に確認してください（問題なければ1行で報告）。"
else
    echo "【整合性確認】仕様ドキュメントが変更されました。変更内容に対応するコード実装が追従しているか簡潔に確認してください（問題なければ1行で報告）。"
fi

[ -n "$CHANGED_DOCS" ] && echo "変更ドキュメント: $(echo "$CHANGED_DOCS" | tr '\n' ' ')"
[ -n "$CHANGED_CODE" ] && echo "変更コード: $(echo "$CHANGED_CODE" | tr '\n' ' ')"
